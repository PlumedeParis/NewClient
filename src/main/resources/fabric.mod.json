{
	"schemaVersion": 1,
	"id": "newclient",
	"version": "${version}",
	"name": "NewClient",
	"description": "Client-side utility client for anarchy servers: BlockESP, BaseFinder, Freecam, PlayerDetector and SusChunk. Never sends anything to the server.",
	"authors": ["PlumedeParis"],
	"license": "MIT",
	"icon": "assets/newclient/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.newclient.NewClient"]
	},
	"mixins": ["newclient.mixins.json"],
	"depends": {
		"fabricloader": ">=0.17.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
